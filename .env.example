# Anthropic API key — required for real PTS-100 scoring.
# Without it, the app returns a labelled all-PASS mock so the flow is still usable.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-haiku-4-5)
PTS_MODEL=claude-haiku-4-5

# Optional: custom Anthropic base URL (e.g. an EU endpoint the organisers provide)
ANTHROPIC_BASE_URL=
