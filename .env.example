# === Provider selection ===
# The app picks a provider in this order:
#   1. OPENROUTER_API_KEY  -> OpenRouter (OpenAI-compatible, third-party router)
#   2. ANTHROPIC_API_KEY   -> Anthropic Messages API (the issued team key)
#   3. neither             -> labelled all-PASS mock (flow still usable)
#
# NOTE: the original Team 14 spec forbids third-party routers ("No OpenRouter").
# OpenRouter support here is opt-in for convenience/testing only.

# --- Anthropic (spec-compliant path) ---
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-haiku-4-5)
PTS_MODEL=claude-haiku-4-5
# Optional: custom Anthropic base URL (e.g. an EU endpoint the organisers provide)
ANTHROPIC_BASE_URL=

# --- OpenRouter (opt-in fallback) ---
OPENROUTER_API_KEY=
# Optional: override the OpenRouter model (default: anthropic/claude-haiku-4.5)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional: custom OpenRouter base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=

# === Two-pass assessment (prosecutor -> judge -> scorer) ===
# Turn the two-pass architecture on (default) or fall back to a single call.
#   1 = two-pass (default), 0 = single-pass
PTS_TWO_PASS=1
# Recall pass. Lists allegations; cheap/fast model is fine.
# Default: claude-haiku-4-5 (Anthropic) / anthropic/claude-haiku-4.5 (OpenRouter)
PTS_PROSECUTOR_MODEL=
# Number of independent prosecutor runs to union (default: 3). Runs execute in
# parallel, so wall-clock cost is ~one run; 2 is a good production setting.
PTS_PROSECUTOR_RUNS=3
# Sampling temperature for the prosecutor (default: 0.7).
PTS_PROSECUTOR_TEMPERATURE=0.7
# Precision pass. Strongest model recommended.
# Default: claude-sonnet-4-5 (Anthropic) / anthropic/claude-sonnet-4.5 (OpenRouter)
PTS_JUDGE_MODEL=
# Number of judge runs; majority-confirm when > 1 (default: 1).
PTS_JUDGE_RUNS=1
# Characters per chunk for long articles; the judge always sees the full text
# (default: 6000).
PTS_CHUNK_CHARS=6000

# === Scoring hardening (Part 2) ===
# 1 (default) applies severity ceilings, the own-voice stance x1.5 multiplier,
# additive per-occurrence penalties, the judge-floor and consistency governance.
# 0 disables the whole layer. All values are tuned in src/lib/rubric.ts.
PTS_HARDENING=1

# === Dev / debug ===
# Allow the labelled all-PASS mock provider (NEVER set in production).
#   1 = enable mock when no real key is present
PTS_ALLOW_MOCK=
# Add a `debug` block (provider, timings, raw assessment, lexicon hits) to the
# /api/assess response. Also enabled per-request with ?debug=1.
PTS_DEBUG=
