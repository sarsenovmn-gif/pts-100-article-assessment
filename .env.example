# === Provider selection ===
# The app picks a provider in this order:
#   1. OPENROUTER_API_KEY  -> OpenRouter (OpenAI-compatible, third-party router)
#   2. ANTHROPIC_API_KEY   -> Anthropic Messages API (the issued team key)
#   3. neither             -> labelled all-PASS mock (flow still usable)
#
# NOTE: the original Team 14 spec forbids third-party routers ("No OpenRouter").
# OpenRouter support here is opt-in for convenience/testing only.

# --- Anthropic (spec-compliant path) ---
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-haiku-4-5)
PTS_MODEL=claude-haiku-4-5
# Optional: custom Anthropic base URL (e.g. an EU endpoint the organisers provide)
ANTHROPIC_BASE_URL=

# --- OpenRouter (opt-in fallback) ---
OPENROUTER_API_KEY=
# Optional: override the OpenRouter model (default: anthropic/claude-haiku-4.5)
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional: custom OpenRouter base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
